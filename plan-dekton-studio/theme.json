{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1440px"
    },
    "color": {
      "custom": false,
      "palette": [
        { "slug": "black-950", "color": "#030303", "name": "Black 950" },
        { "slug": "black-900", "color": "#070707", "name": "Black 900" },
        { "slug": "graphite", "color": "#1D1D1B", "name": "Graphite" },
        { "slug": "stone-white", "color": "#F4F1EA", "name": "Stone White" },
        { "slug": "soft-gray", "color": "#B8B2A8", "name": "Soft Gray" },
        { "slug": "champagne", "color": "#C9A76A", "name": "Champagne" },
        { "slug": "bronze", "color": "#8A6A3F", "name": "Bronze" },
        { "slug": "deep-green", "color": "#12352F", "name": "Deep Green" },
        { "slug": "clay-red", "color": "#7A2E25", "name": "Clay Red" },
        { "slug": "walnut", "color": "#5A3E2B", "name": "Walnut" }
      ]
    },
    "spacing": {
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "20", "size": "clamp(1rem, 2vw, 1.25rem)", "name": "20" },
        { "slug": "40", "size": "clamp(2rem, 5vw, 4rem)", "name": "40" },
        { "slug": "60", "size": "clamp(4rem, 8vw, 7rem)", "name": "60" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "slug": "studio-sans",
          "name": "Studio Sans"
        },
        {
          "fontFamily": "Georgia, 'Times New Roman', serif",
          "slug": "studio-serif",
          "name": "Studio Serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "base", "size": "1rem", "name": "Base" },
        { "slug": "medium", "size": "1.25rem", "name": "Medium" },
        { "slug": "large", "size": "clamp(2rem, 5vw, 4.5rem)", "name": "Large" },
        { "slug": "display", "size": "clamp(3.2rem, 9vw, 8.8rem)", "name": "Display" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#070707",
      "text": "#F4F1EA"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--studio-sans)",
      "lineHeight": "1.55"
    },
    "elements": {
      "link": {
        "color": { "text": "#E8D4A2" },
        ":hover": { "color": { "text": "#C9A76A" } }
      },
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "0.95"
        },
        "color": { "text": "#F4F1EA" }
      }
    }
  }
}

